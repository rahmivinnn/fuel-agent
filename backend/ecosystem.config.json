{
  "apps": [{
    "name": "fuel-agent",
    "script": "npm",
    "args": "run dev",
    "instances": 1,
    "exec_mode": "fork",
    "env": {
      "NODE_ENV": "development"
    },
    "env_production": {
      "NODE_ENV": "production",
      "script": "dist/index.js",
      "args": ""
    },
    "restart_delay": 2000,
    "max_restarts": 5,
    "log_date_format": "YYYY-MM-DD HH:mm:ss Z",
    "merge_logs": true,
    "log_file": "./logs/app.log",
    "error_file": "./logs/error.log",
    "out_file": "./logs/out.log"
  }]
}