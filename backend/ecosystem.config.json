{
  "apps": [{
    "name": "fuel-agent",
    "script": "dist/index.js",
    "instances": 1,
    "exec_mode": "cluster",
    "env": {
      "NODE_ENV": "development"
    },
    "env_production": {
      "NODE_ENV": "production"
    },
    "pre_start": "npm run db:push",
    "restart_delay": 2000,
    "max_restarts": 5,
    "log_file": "./logs/app.log",
    "error_file": "./logs/error.log",
    "out_file": "./logs/out.log"
  }]
}